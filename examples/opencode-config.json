    "llmgateway": {
      "name": "LLM Gateway",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:7331/v1",
        "apiKey": "{env:LLMGATEWAY_API_KEY}"
      },
      "models": {
        "llmgateway-auto": { "name": "LLM Gateway Auto" },
